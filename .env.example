# Kinde — issuer, shared by sign-in and webhook verification
KINDE_ISSUER_URL=

# Kinde — back-end web app (user sign-in)
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_REDIRECT_URI=
KINDE_POST_LOGOUT_REDIRECT_URI=

# Kinde — M2M app (Management API)
KINDE_M2M_CLIENT_ID=
KINDE_M2M_CLIENT_SECRET=

# These three also need to exist as CONVEX deployment env vars, not just
# here — convex/reconciliation.ts's cron-driven sweep runs on Convex's own
# infrastructure and reads process.env there, which .env.local never
# reaches. Set them once with:
#   npx convex env set KINDE_ISSUER_URL <value>
#   npx convex env set KINDE_M2M_CLIENT_ID <value>
#   npx convex env set KINDE_M2M_CLIENT_SECRET <value>
# The M2M application in Kinde also needs the read:users scope authorized
# (Settings > Applications > that app > APIs), in addition to update:users.

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Convex
NEXT_PUBLIC_CONVEX_URL=

# App
APP_SITE_URL=http://localhost:3000
SESSION_SECRET=

# Resolved server-side only. Only the exact value "naive" selects the hole;
# anything else — a typo, an empty value, "enforced" — resolves to enforced.
# Never read from the browser or a request.
ENFORCEMENT_MODE=enforced

# scripts/e2e-narrative.ts only — a real Kinde user id it suspends and
# restores repeatedly. Use a test account, not a real person's, and expect
# both `npm run dev` and `npx convex dev` to already be running (it drives
# the actual webhook path over your configured tunnel, not a mock).
E2E_KINDE_USER_ID=
